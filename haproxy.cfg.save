q
sudo truncate -s 0 haproxy.cfg
q
sudo docker-compose up -d
obal
  maxconn 4096
  #log stdout format raw

defaults
  mode tcp
  timeout connect 5s
  timeout client  1h
  timeout server  1h

frontend cockroach-sql
  bind *:26256
  default_backend cockroach-nodes

backend cockroach-nodes
  balance roundrobin
  option httpchk GET /health
  server cockroachdb-1 cockroachdb-1:26257 check port 8080
  server cockroachdb-2 cockroachdb-2:26257 check port 8080
  server cockroachdb-3 cockroachdb-3:26257 check port 8080 
